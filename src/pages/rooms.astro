---
/**
 * Rooms & Accommodations Page - Delta Suites Beypore
 * Premier luxury card layout design (Pricing removed as requested).
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PlanYourStay from '../components/PlanYourStay.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import roomDeluxe from '../assets/images/room_deluxe.webp';
import roomExecutive from '../assets/images/room_executive.webp';
import roomPresidential from '../assets/images/room_presidential.webp';

const BOOKING_URL = "https://mobilebe.stayflexi.com/39879/?checkin=17-08-2026&num_nights=1&num_guests=2&source=google&hotel_id=39879";

const roomDetails = [
  {
    id: "deluxe-room",
    num: "01",
    badge: "MOST POPULAR",
    name: "Deluxe Room",
    subtitle: "Comfortable & Contemporary Sanctuary",
    description: "A comfortable and contemporary room designed for a relaxing stay in Beypore. Equipped with modern conveniences and serene decor for single guests or couples.",
    image: roomDeluxe,
    spec: "280 Sq. Ft. • King / Queen Bed",
    amenities: [
      "King/Queen bed",
      "Air conditioning",
      "Smart/LED TV",
      "Wi-Fi",
      "Tea & coffee facilities",
      "Wardrobe",
      "Work desk",
      "Attached bathroom"
    ]
  },
  {
    id: "executive-suite",
    num: "02",
    badge: "EXECUTIVE LUXURY",
    name: "Executive Suite",
    subtitle: "Spacious Living with Upgraded Amenities",
    description: "Our Executive Suites offer a refined mix of comfort, modern aesthetics, and smart functionality. Features mini lounge seating and enhanced amenities tailored for business executives and families.",
    image: roomExecutive,
    spec: "420 Sq. Ft. • Premium King",
    amenities: [
      "Premium King size bed",
      "Air conditioning",
      "43\" Smart/LED TV",
      "High-speed Wi-Fi",
      "Tea & coffee maker",
      "Mini lounge seating",
      "Work desk & chair",
      "Ensuite bathroom"
    ]
  },
  {
    id: "presidential-suite",
    num: "03",
    badge: "SIGNATURE EXPERIENCE",
    name: "Presidential Suite",
    subtitle: "The Ultimate Statement of Luxury & Privacy",
    description: "The crown jewel of Delta Suites. Features an expansive master bedroom, separate living & dining area, deep soaking tub, and VIP hospitality services for an unforgettable stay.",
    image: roomPresidential,
    spec: "650 Sq. Ft. • Emperor King",
    amenities: [
      "Emperor King bed",
      "Air conditioning",
      "55\" Smart/LED TV",
      "High-speed Wi-Fi",
      "Separate living & dining area",
      "Minibar & coffee machine",
      "Executive work desk",
      "Soaking tub / Jacuzzi"
    ]
  }
];
---

<Layout title="Rooms & Suites | Delta Suites Beypore">
  <Header isSolid={true} />

  <main id="rooms-page" class="bg-[#FAF7F3] pt-20 pb-16 sm:pb-24 overflow-hidden">
    
    <!-- COMPACT PAGE HERO HEADER -->
    <div class="max-w-3xl mx-auto px-4 text-center py-8 sm:py-14 space-y-2 rooms-page-reveal rooms-page-fade-down">
      <!-- Eyebrow Tag -->
      <div class="flex items-center justify-center gap-2.5 mb-1">
        <div class="w-8 h-[1px] bg-[#D4A373]"></div>
        <span class="text-[#b8860b] text-[10px] sm:text-[11px] font-bold tracking-[0.2em] uppercase">
          ACCOMMODATIONS & SUITES
        </span>
        <div class="w-8 h-[1px] bg-[#D4A373]"></div>
      </div>

      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-[#1c0c30] tracking-tight" style="font-family: 'Cormorant Garamond', serif;">
        Rooms & Suites
      </h1>

      <p class="text-[#554960] text-xs sm:text-sm max-w-lg mx-auto leading-relaxed font-normal">
        Understated luxury, modern amenities, and supreme comfort in the heart of Beypore, Kozhikode.
      </p>
    </div>

    <!-- ROOM DETAILS SHOWCASE CARDS (MATCHING REFERENCE UI IMAGE) -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16 sm:space-y-24">
      {roomDetails.map((room, index) => (
        <div 
          id={room.id}
          style={`--stagger-index: ${index};`}
          class={`rooms-page-reveal rooms-page-card-stagger grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center ${
            index % 2 === 1 ? 'lg:flex-row-reverse' : ''
          }`}
        >
          <!-- Room Image Showcase (6 cols) -->
          <div class={`lg:col-span-6 relative ${index % 2 === 1 ? 'lg:order-2' : 'lg:order-1'}`}>
            <div class="relative w-full aspect-[16/11] rounded-[28px] overflow-hidden border border-[#e8ded0] shadow-lg group bg-[#1c0c30]/5">
              <Image 
                src={room.image} 
                alt={room.name} 
                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out" 
                loading="lazy" 
              />

              <!-- Floating Circular Dark Emblem Badge (Top Left) -->
              <div class="absolute top-5 left-5 w-12 h-12 rounded-full bg-[#1c0c30] text-[#D4A373] font-serif font-bold text-xl flex items-center justify-center shadow-md border border-[#D4A373]/30" style="font-family: 'Cormorant Garamond', serif;">
                {room.num}
              </div>

              <!-- Spec Floating Badge (Bottom Right) -->
              <div class="absolute bottom-5 right-5 bg-white/95 backdrop-blur-md px-4 py-2 rounded-xl border border-[#e8ded0] text-xs font-semibold text-[#1c0c30] shadow-sm flex items-center gap-1.5">
                <span>🛏️ {room.spec}</span>
              </div>
            </div>
          </div>

          <!-- Room Information Stack (6 cols) -->
          <div class={`lg:col-span-6 space-y-4 ${index % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
            
            <!-- Category Tag -->
            <span class="text-[10px] font-bold text-[#b8860b] uppercase tracking-[0.2em] bg-[#FAF5ED] border border-[#e8ded0] px-3.5 py-1.5 rounded-full inline-block">
              {room.badge}
            </span>

            <!-- Title -->
            <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#1c0c30] leading-snug" style="font-family: 'Cormorant Garamond', serif;">
              {room.name}
            </h2>

            <!-- Subtitle -->
            <p class="text-[#b8860b] text-xs sm:text-sm font-serif italic font-medium">
              {room.subtitle}
            </p>

            <!-- Description -->
            <p class="text-[#554960] text-xs sm:text-sm leading-relaxed font-normal">
              {room.description}
            </p>

            <!-- Key Features / Amenities Chips -->
            <div class="pt-2">
              <span class="text-[11px] font-bold text-[#1c0c30] uppercase tracking-wider block mb-2">
                KEY FEATURES:
              </span>
              <div class="flex flex-wrap gap-2">
                {room.amenities.map(item => (
                  <span class="bg-[#FAF5ED] text-[#554960] text-[11px] font-medium px-3 py-1.5 rounded-full border border-[#e8ded0] inline-flex items-center gap-1.5">
                    <span class="text-[#b8860b] text-[8px]">✦</span>
                    <span>{item}</span>
                  </span>
                ))}
              </div>
            </div>

            <!-- Booking CTA Button -->
            <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-[#e8ded0]">
              <div>
                <span class="text-[10px] text-[#6b5c77] block uppercase tracking-wider">Best Direct Rates</span>
                <span class="text-xs font-bold text-[#1c0c30]">Instant Booking Guaranteed</span>
              </div>

              <a 
                href={BOOKING_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="group w-full sm:w-auto bg-[#1c0c30] hover:bg-[#b8860b] text-white font-bold text-xs uppercase tracking-[0.18em] py-3.5 px-8 rounded-full transition-all duration-300 shadow-md inline-flex items-center justify-center gap-2 cursor-pointer transform hover:-translate-y-0.5"
              >
                <span>BOOK THIS ROOM</span>
                <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>

          </div>
        </div>
      ))}
    </div>

  </main>

  <PlanYourStay />
  <Footer />
</Layout>

<script is:inline>
  (function() {
    var mainEl = document.getElementById('rooms-page');
    if (!mainEl) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('rooms-page-visible');
        } else {
          entry.target.classList.remove('rooms-page-visible');
        }
      });
    }, { threshold: 0.05 });

    observer.observe(mainEl);

    // Also observe individual room cards for smooth scroll entrance
    var cards = document.querySelectorAll('.rooms-page-card-stagger');
    var cardObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('card-in-view');
        } else {
          entry.target.classList.remove('card-in-view');
        }
      });
    }, { threshold: 0.1 });

    cards.forEach(function(card) {
      cardObserver.observe(card);
    });
  })();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap');

  .rooms-page-reveal {
    opacity: 0;
    will-change: transform, opacity;
    transition: transform 1.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rooms-page-fade-down { transform: translateY(-30px); }
  .rooms-page-card-stagger { transform: translateY(45px); }

  #rooms-page.rooms-page-visible .rooms-page-fade-down {
    opacity: 1;
    transform: translateY(0);
  }

  .rooms-page-card-stagger.card-in-view {
    opacity: 1;
    transform: translateY(0);
  }
</style>
