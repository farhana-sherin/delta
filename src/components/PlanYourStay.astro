---
/**
 * Ready to Plan Your Stay Component - Delta Suites
 * Compact luxury call-to-action section rendered right above the footer.
 */
import { Image } from 'astro:assets';
import propertyImg from '../assets/images/gallery_property.webp';

const BOOKING_URL = "https://mobilebe.stayflexi.com/39879/?checkin=17-08-2026&num_nights=1&num_guests=2&source=google&hotel_id=39879";
---

<section id="plan-your-stay" class="relative w-full bg-[#120524] text-white py-10 sm:py-14 overflow-hidden border-t border-[#e8ded0]/20">
  
  <!-- Background Image with Overlay Vignette -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={propertyImg} 
      alt="Delta Suites Beypore Property" 
      class="w-full h-full object-cover opacity-20 filter brightness-75 scale-105" 
      loading="lazy" 
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#120524] via-[#120524]/90 to-[#120524]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#120524] via-transparent to-[#120524]"></div>
  </div>

  <!-- Ambient Gold Light Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[30rem] h-[15rem] bg-[#D4A373]/15 rounded-full filter blur-3xl pointer-events-none"></div>

  <div class="max-w-3xl w-full mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-3.5">
    
    <!-- Gold Eyebrow Badge -->
    <div class="inline-flex items-center gap-2.5 bg-white/5 border border-[#D4A373]/30 backdrop-blur-md px-4 py-1.5 rounded-full shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-[#D4A373]"></span>
      <span class="text-[#D4A373] text-[9.5px] sm:text-[10px] font-bold tracking-[0.2em] uppercase">
        YOUR LUXURY BEYPORE ESCAPE
      </span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#D4A373]"></span>
    </div>

    <!-- Main Title -->
    <h2 class="text-2xl sm:text-4xl font-serif font-bold tracking-tight text-white leading-tight" style="font-family: 'Cormorant Garamond', serif;">
      Ready to Plan Your Stay?
    </h2>

    <!-- Subtitle -->
    <p class="text-white/80 text-xs sm:text-sm font-light max-w-lg mx-auto leading-relaxed">
      Experience the comfort, elegance, and warm Kerala hospitality at Delta Suites Beypore.
    </p>

    <!-- Action Buttons -->
    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
      <!-- Primary Gold Book Now Button -->
      <a 
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group w-full sm:w-auto bg-[#b8860b] hover:bg-[#D4A373] text-white font-bold text-[11px] uppercase tracking-[0.18em] py-3 px-8 rounded-full transition-all duration-300 shadow-md hover:shadow-xl inline-flex items-center justify-center gap-2.5 cursor-pointer"
      >
        <span>BOOK YOUR STAY NOW</span>
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>

      <!-- Secondary Outline Button -->
      <a 
        href="/contact"
        class="group w-full sm:w-auto bg-white/5 hover:bg-white text-white hover:text-[#120524] border border-white/30 font-bold text-[11px] uppercase tracking-[0.18em] py-3 px-7 rounded-full transition-all duration-300 backdrop-blur-md inline-flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>GET IN TOUCH</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75" />
        </svg>
      </a>
    </div>

  </div>
</section>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap');
</style>
