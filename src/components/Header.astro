---
import { Image } from 'astro:assets';
import logoImage from '../assets/images/logo.webp';

interface Props {
  isSolid?: boolean;
}

const { isSolid = false } = Astro.props;
---

<header id="main-header" class="fixed top-0 inset-x-0 z-50 bg-[#120524]/95 backdrop-blur-md border-b border-white/10 shadow-xl text-white font-sans text-xs tracking-wider transition-all duration-500 ease-in-out">
  <!-- Top Bar (Desktop) -->
  <div id="header-top-bar" class={`hidden md:flex justify-between items-center py-2 px-4 md:px-8 xl:px-16 border-b border-white/10 ${isSolid ? 'bg-[#120524]' : 'bg-[#120524]/80'} text-[10px] text-white/70 transition-all duration-500 ease-in-out overflow-hidden max-h-12 opacity-100`}>
    <div class="flex items-center gap-2">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#D4A373" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
      <a href="https://www.google.com/search?kgmid=/g/11zd9dks8t&q=Delta+Suites+By+Addon" target="_blank" rel="noopener noreferrer" class="hover:text-[#D4A373] transition-colors">
        Beypore, Kozhikode, Kerala, India
      </a>
    </div>
    <div class="flex items-center gap-6">
      <div class="flex items-center gap-2">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#D4A373" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <a href="tel:+917907188227" class="hover:text-[#D4A373] transition-colors">+91 79071 88227</a>
      </div>
      <div class="flex items-center gap-3 border-l border-white/20 pl-6">
        <a href="https://wa.me/917907188227" target="_blank" rel="noopener noreferrer" class="hover:text-[#D4A373] transition-colors" title="WhatsApp Us">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.157 4.228 4.316-1.127z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Nav Bar -->
  <div id="header-nav-bar" class="py-3 md:py-3.5 px-4 md:px-8 xl:px-16 uppercase font-medium transition-all duration-300">
    <div class="max-w-[1400px] mx-auto flex items-center justify-between pointer-events-auto">
      
      <!-- Logo left side -->
      <a href="/" class="flex flex-col items-start justify-center group">
        <Image src={logoImage} alt="Delta Suites Logo" class="h-9 md:h-11 w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
      </a>

      <!-- Desktop Nav Center -->
      <nav class="hidden xl:flex items-center gap-6 2xl:gap-8 text-[11px] 2xl:text-[12px] opacity-90">
        <a href="/" class="hover:text-[#D4A373] transition-colors relative after:absolute after:-bottom-2 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-[1px] after:bg-[#D4A373] hover:after:w-4 after:transition-all after:duration-300">HOME</a>
        <a href="/#about" class="hover:text-[#D4A373] transition-colors relative after:absolute after:-bottom-2 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-[1px] after:bg-[#D4A373] hover:after:w-4 after:transition-all after:duration-300">ABOUT US</a>
        <a href="/rooms" class="hover:text-[#D4A373] transition-colors relative after:absolute after:-bottom-2 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-[1px] after:bg-[#D4A373] hover:after:w-4 after:transition-all after:duration-300">ROOMS</a>
        <a href="/dining" class="hover:text-[#D4A373] transition-colors relative after:absolute after:-bottom-2 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-[1px] after:bg-[#D4A373] hover:after:w-4 after:transition-all after:duration-300">DINING</a>
        <a href="/faq" class="hover:text-[#D4A373] transition-colors relative after:absolute after:-bottom-2 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-[1px] after:bg-[#D4A373] hover:after:w-4 after:transition-all after:duration-300">FAQ</a>
        <a href="/contact" class="hover:text-[#D4A373] transition-colors relative after:absolute after:-bottom-2 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-[1px] after:bg-[#D4A373] hover:after:w-4 after:transition-all after:duration-300">CONTACT</a>
      </nav>

      <!-- Desktop CTA & Mobile Hamburger Button -->
      <div class="flex items-center gap-3">
        <a href="https://mobilebe.stayflexi.com/39879/?checkin=17-08-2026&num_nights=1&num_guests=2&source=google&hotel_id=39879" target="_blank" rel="noopener noreferrer" class="hidden xl:inline-flex items-center justify-center border border-[#D4A373] text-[#D4A373] px-6 py-2 hover:bg-[#D4A373] hover:text-black transition-all duration-300 font-semibold tracking-widest text-[11px] rounded-full shadow-sm hover:shadow-[0_0_20px_rgba(212,163,115,0.4)]">
          BOOK NOW
        </a>

        <!-- Mobile Hamburger Toggle Button -->
        <button 
          id="mobile-menu-btn" 
          type="button" 
          aria-label="Toggle mobile menu" 
          class="xl:hidden p-2 rounded-xl bg-white/10 border border-white/20 text-white hover:text-[#D4A373] hover:bg-white/20 transition-all cursor-pointer shadow-md"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Overlay (Minimalist Luxury UI) -->
<div 
  id="mobile-drawer" 
  class="fixed inset-0 z-[100] bg-[#0c0218]/98 backdrop-blur-2xl flex flex-col justify-between p-6 md:p-10 opacity-0 pointer-events-none transition-all duration-300 xl:hidden overflow-y-auto"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-between border-b border-white/10 pb-5">
    <a href="/" class="flex items-center">
      <Image src={logoImage} alt="Delta Suites Logo" class="h-9 w-auto object-contain" />
    </a>

    <!-- Close Drawer Button -->
    <button 
      id="close-drawer-btn" 
      type="button" 
      aria-label="Close mobile menu" 
      class="w-9 h-9 rounded-full bg-white/5 border border-white/15 text-white/80 flex items-center justify-center hover:text-[#D4A373] hover:border-[#D4A373] transition-colors cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Minimalist Nav Menu -->
  <nav class="py-8 flex-1 flex flex-col justify-center items-center gap-4 text-center">
    <a href="/" class="mobile-nav-link text-xs tracking-[0.2em] font-medium uppercase text-white/80 hover:text-[#D4A373] transition-colors py-1 text-center">HOME</a>
    <a href="/#about" class="mobile-nav-link text-xs tracking-[0.2em] font-medium uppercase text-white/80 hover:text-[#D4A373] transition-colors py-1 text-center">ABOUT US</a>
    <a href="/rooms" class="mobile-nav-link text-xs tracking-[0.2em] font-medium uppercase text-white/80 hover:text-[#D4A373] transition-colors py-1 text-center">ROOMS & SUITES</a>
    <a href="/dining" class="mobile-nav-link text-xs tracking-[0.2em] font-medium uppercase text-white/80 hover:text-[#D4A373] transition-colors py-1 text-center">DINING & RESTAURANT</a>
    <a href="/faq" class="mobile-nav-link text-xs tracking-[0.2em] font-medium uppercase text-white/80 hover:text-[#D4A373] transition-colors py-1 text-center">FAQ</a>
    <a href="/contact" class="mobile-nav-link text-xs tracking-[0.2em] font-medium uppercase text-white/80 hover:text-[#D4A373] transition-colors py-1 text-center">CONTACT</a>
  </nav>

  <!-- Drawer Footer Action -->
  <div class="border-t border-white/10 pt-5">
    <a 
      href="https://mobilebe.stayflexi.com/39879/?checkin=17-08-2026&num_nights=1&num_guests=2&source=google&hotel_id=39879" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="w-full border border-[#D4A373] text-[#D4A373] hover:bg-[#D4A373] hover:text-black font-semibold text-[11px] uppercase tracking-widest py-3 rounded-full text-center block transition-all duration-300"
    >
      BOOK STAY
    </a>
  </div>
</div>

<!-- Scroll To Top Button -->
<button 
  id="scroll-to-top-btn" 
  type="button" 
  aria-label="Scroll to top of page" 
  class="fixed bottom-6 left-6 z-40 h-10 w-10 md:h-11 md:w-11 rounded-full bg-[#120524]/90 backdrop-blur-md text-[#D4A373] border border-[#D4A373]/40 shadow-2xl flex items-center justify-center opacity-0 pointer-events-none translate-y-4 transition-all duration-300 hover:bg-[#D4A373] hover:text-black hover:border-[#D4A373] hover:shadow-[0_0_20px_rgba(212,163,115,0.5)] cursor-pointer group"
>
  <svg class="w-4 h-4 md:w-5 md:h-5 transform group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
  </svg>
</button>

<!-- Minimalist Floating Quick Contact Widget (Bottom Right Corner) -->
<div class="xl:hidden">
  <!-- Minimalist Popup Action Cards -->
  <div 
    id="quick-contact-menu" 
    class="fixed bottom-16 right-5 z-50 bg-[#120524]/95 backdrop-blur-xl border border-white/15 shadow-2xl rounded-2xl p-2.5 w-48 space-y-1.5 opacity-0 pointer-events-none transition-all duration-200 scale-95 origin-bottom-right"
  >
    <!-- Direct Booking Button -->
    <a 
      href="https://mobilebe.stayflexi.com/39879/?checkin=17-08-2026&num_nights=1&num_guests=2&source=google&hotel_id=39879" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="flex items-center justify-between bg-[#D4A373] hover:bg-[#b8860b] text-black px-3 py-2 rounded-xl text-[10.5px] font-bold tracking-wider transition-colors"
    >
      <span>BOOK STAY</span>
      <span>→</span>
    </a>

    <!-- WhatsApp Button -->
    <a 
      href="https://wa.me/917907188227" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="flex items-center gap-2.5 bg-white/5 hover:bg-white/10 text-white/90 px-3 py-2 rounded-xl text-[10.5px] font-medium tracking-wider transition-colors"
    >
      <svg class="w-3.5 h-3.5 text-[#D4A373]" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.157 4.228 4.316-1.127z"/></svg>
      <span>WhatsApp</span>
    </a>

    <!-- Call Button -->
    <a 
      href="tel:+917907188227" 
      class="flex items-center gap-2.5 bg-white/5 hover:bg-white/10 text-white/90 px-3 py-2 rounded-xl text-[10.5px] font-medium tracking-wider transition-colors"
    >
      <svg class="w-3.5 h-3.5 text-[#D4A373]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.826-1.47-5.11-3.754-6.58-6.58l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
      <span>Call Us</span>
    </a>
  </div>

  <!-- Minimalist Floating Button -->
  <button 
    id="quick-contact-btn" 
    type="button" 
    aria-label="Quick contact & reservation menu" 
    class="fixed bottom-4 right-4 z-50 h-11 w-11 rounded-full bg-[#120524]/90 backdrop-blur-md text-[#D4A373] border border-white/20 shadow-xl flex items-center justify-center hover:border-[#D4A373] transition-all cursor-pointer"
  >
    <svg id="fab-icon-phone" class="w-5 h-5 text-[#D4A373]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.826-1.47-5.11-3.754-6.58-6.58l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
    </svg>

    <svg id="fab-icon-close" class="w-4 h-4 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<script is:inline>
  (function() {
    var header = document.getElementById('main-header');
    var topBar = document.getElementById('header-top-bar');
    var navBar = document.getElementById('header-nav-bar');
    var scrollTopBtn = document.getElementById('scroll-to-top-btn');

    // Header Scroll Animation & Scroll-to-Top Button Visibility
    function handleScroll() {
      var scrollY = window.scrollY || window.pageYOffset;

      // Header compaction on scroll down, expansion on scroll back to top
      if (scrollY > 50) {
        if (header) {
          header.classList.add('bg-[#080210]/98', 'shadow-2xl', 'border-[#D4A373]/30');
          header.classList.remove('bg-[#120524]/95', 'border-white/10');
        }
        if (navBar) {
          navBar.classList.remove('py-3', 'md:py-3.5');
          navBar.classList.add('py-2', 'md:py-2.5');
        }
      } else {
        if (header) {
          header.classList.remove('bg-[#080210]/98', 'shadow-2xl', 'border-[#D4A373]/30');
          header.classList.add('bg-[#120524]/95', 'border-white/10');
        }
        if (navBar) {
          navBar.classList.remove('py-2', 'md:py-2.5');
          navBar.classList.add('py-3', 'md:py-3.5');
        }
      }

      // Scroll to Top button reveal
      if (scrollTopBtn) {
        if (scrollY > 300) {
          scrollTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
          scrollTopBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        } else {
          scrollTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
          scrollTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Mobile Navigation Drawer Toggle
    function toggleDrawer(open) {
      var drawer = document.getElementById('mobile-drawer');
      if (!drawer) return;
      if (open) {
        document.body.style.overflow = 'hidden';
        drawer.classList.remove('opacity-0', 'pointer-events-none');
        drawer.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        drawer.classList.remove('opacity-100', 'pointer-events-auto');
        drawer.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }
    }

    // Quick Contact Widget Toggle
    function toggleQuickContact() {
      var menu = document.getElementById('quick-contact-menu');
      var iconPhone = document.getElementById('fab-icon-phone');
      var iconClose = document.getElementById('fab-icon-close');
      if (!menu) return;

      var isOpen = menu.classList.contains('opacity-100');
      if (isOpen) {
        menu.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
        menu.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        iconPhone.classList.remove('hidden');
        iconClose.classList.add('hidden');
      } else {
        menu.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
        menu.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
        iconPhone.classList.add('hidden');
        iconClose.classList.remove('hidden');
      }
    }

    document.addEventListener('click', function(e) {
      // Scroll To Top Click
      var topBtn = e.target.closest('#scroll-to-top-btn');
      if (topBtn) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }

      // Mobile Drawer Clicks
      var menuBtn = e.target.closest('#mobile-menu-btn');
      if (menuBtn) {
        toggleDrawer(true);
        return;
      }
      var closeBtn = e.target.closest('#close-drawer-btn');
      if (closeBtn) {
        toggleDrawer(false);
        return;
      }
      var navLink = e.target.closest('.mobile-nav-link');
      if (navLink) {
        toggleDrawer(false);
        return;
      }

      // Quick Contact Button Click
      var fabBtn = e.target.closest('#quick-contact-btn');
      if (fabBtn) {
        toggleQuickContact();
        return;
      }

      // Close Quick Contact Menu if clicked outside
      var quickMenu = document.getElementById('quick-contact-menu');
      if (quickMenu && quickMenu.classList.contains('opacity-100') && !e.target.closest('#quick-contact-menu')) {
        toggleQuickContact();
      }
    });
  })();
</script>
