---
import { Image } from 'astro:assets';
import hotelImage from '../assets/images/flat.webp';
---

<section id="about" class="relative w-full bg-[#fdf9f1] py-14 sm:py-20 lg:py-24 overflow-hidden">
  
  <!-- Subtle Ambient Glow Accents -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-[#D4A373]/10 rounded-full filter blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-[#1c0c30]/5 rounded-full filter blur-3xl pointer-events-none"></div>

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      
      <!-- Left Column: Narrative & Amenities (7 Cols) -->
      <div class="lg:col-span-7 space-y-6 text-left">
        
        <!-- Eyebrow Tag -->
        <div class="flex items-center gap-3">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-[#b8860b] shrink-0">
            <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="currentColor"/>
          </svg>
          <div class="w-10 h-[1px] bg-[#D4A373]/60"></div>
          <span class="text-[#b8860b] text-xs font-bold tracking-[0.2em] uppercase">
            YOUR COMFORTABLE STAY IN BEYPORE
          </span>
        </div>

        <!-- Main Heading -->
        <h2 class="text-4xl sm:text-5xl lg:text-[56px] font-serif font-bold tracking-tight text-[#1c0c30] leading-[1.1]" style="font-family: 'Cormorant Garamond', serif;">
          Welcome to <span class="text-[#b8860b] italic font-normal">Delta Suites</span>
        </h2>

        <!-- Gold Accent Line with Diamond -->
        <div class="flex items-center gap-2.5 py-0.5">
          <div class="w-10 h-[1px] bg-[#D4A373]"></div>
          <div class="w-1.5 h-1.5 rotate-45 bg-[#D4A373]"></div>
        </div>

        <!-- Narrative Paragraphs -->
        <div class="text-[#594d66] text-sm sm:text-base leading-relaxed space-y-3 font-medium max-w-xl">
          <p>
            <strong class="text-[#1c0c30] font-bold">Delta Suites</strong> is a premium 31-room hotel in Beypore, Kozhikode, created for guests looking for <span class="text-[#b8860b] font-semibold">comfort, convenience</span> and a <span class="text-[#b8860b] font-semibold">relaxing stay</span>.
          </p>
          <p>
            Whether you are travelling with family, visiting Kozhikode for business, planning a weekend getaway or exploring the attractions of Beypore, <strong class="text-[#1c0c30] font-bold">Delta Suites</strong> offers a comfortable base with modern amenities and attentive hospitality.
          </p>
        </div>

        <!-- 4 Amenity Highlights Row with Vertical Dividers -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-[#e8ded0]">
          
          <!-- Item 1: 31 Rooms -->
          <div class="flex items-center gap-3 border-r border-[#e5dad0] pr-2 last:border-r-0">
            <div class="w-10 h-10 rounded-lg bg-[#f4ebd9] border border-[#e2d5c3] flex items-center justify-center text-[#b8860b] shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v11m0-4h18m0 4v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v2m4-6h3a1 1 0 001-1V7a1 1 0 00-1-1H7a1 1 0 00-1 1v1a1 1 0 001 1zm8 0h3a1 1 0 001-1V7a1 1 0 00-1-1h-3a1 1 0 00-1 1v1a1 1 0 001 1z" />
              </svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-[#1c0c30] text-sm font-bold font-serif" style="font-family: 'Cormorant Garamond', serif;">31</span>
              <span class="text-[#867595] text-[9.5px] font-bold uppercase tracking-wider">ROOMS</span>
            </div>
          </div>

          <!-- Item 2: Pool & Gym -->
          <div class="flex items-center gap-3 border-r border-[#e5dad0] pr-2 sm:last:border-r-0">
            <div class="w-10 h-10 rounded-lg bg-[#f4ebd9] border border-[#e2d5c3] flex items-center justify-center text-[#b8860b] shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 17c1.5 0 2.25-.5 3-.5s1.5.5 3 .5 2.25-.5 3-.5 1.5.5 3 .5 2.25-.5 3-.5m-18 3c1.5 0 2.25-.5 3-.5s1.5.5 3 .5 2.25-.5 3-.5 1.5.5 3 .5 2.25-.5 3-.5M15 5a2 2 0 100-4 2 2 0 000 4zm2.5 5.5l-3.5-2.5-3 2 1.5 3.5 3-1.5" />
              </svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-[#1c0c30] text-xs font-bold uppercase tracking-wider">POOL &</span>
              <span class="text-[#867595] text-[9.5px] font-bold uppercase tracking-wider">GYM</span>
            </div>
          </div>

          <!-- Item 3: Dining Facilities -->
          <div class="flex items-center gap-3 border-r border-[#e5dad0] pr-2 last:border-r-0">
            <div class="w-10 h-10 rounded-lg bg-[#f4ebd9] border border-[#e2d5c3] flex items-center justify-center text-[#b8860b] shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4a1 1 0 100 2 1 1 0 000-2zm0 2a8 8 0 00-8 8h16a8 8 0 00-8-8zm-9 11h18" />
              </svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-[#1c0c30] text-xs font-bold uppercase tracking-wider">DINING</span>
              <span class="text-[#867595] text-[9.5px] font-bold uppercase tracking-wider">FACILITIES</span>
            </div>
          </div>

          <!-- Item 4: Heart of Beypore -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-[#f4ebd9] border border-[#e2d5c3] flex items-center justify-center text-[#b8860b] shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-[#1c0c30] text-xs font-bold uppercase tracking-wider">HEART OF</span>
              <span class="text-[#867595] text-[9.5px] font-bold uppercase tracking-wider">BEYPORE</span>
            </div>
          </div>

        </div>

        <!-- CTA Button -->
        <div class="pt-4">
          <a href="#" class="inline-flex items-center gap-3 bg-[#D4A373] text-[#1c0c30] px-8 py-3.5 rounded-xl hover:bg-[#1c0c30] hover:text-white transition-all duration-300 font-bold tracking-wider text-xs uppercase shadow-lg group">
            <span>EXPLORE DELTA SUITES</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="stroke-current transform group-hover:translate-x-1 transition-transform duration-300">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: Massive Rounded Hotel Image (5 Cols) -->
      <div class="lg:col-span-5 relative h-full flex items-center">
        <div class="relative w-full h-[360px] sm:h-[420px] lg:h-[450px] rounded-3xl overflow-hidden shadow-xl border border-[#e8ded0] group">
          <Image 
            src={hotelImage} 
            alt="Delta Suites Hotel External View" 
            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" 
            loading="lazy" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

          <!-- Floating Overlay Badge at Bottom Right -->
          <div class="absolute bottom-5 right-5 bg-[#1c0c30]/90 backdrop-blur-md border border-white/20 rounded-xl px-4 py-2 text-white flex items-center gap-2 shadow-xl">
            <svg class="w-4 h-4 text-[#D4A373]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-xs font-semibold tracking-wide">Beypore, Kozhikode</span>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant Garamond:wght@400;500;600;700&display=swap');
</style>