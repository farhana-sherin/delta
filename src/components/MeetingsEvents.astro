---
/**
 * Meetings & Events Component - Delta Suites
 * Exact match to user reference screenshot, with a slightly larger left image height.
 */
import { Image } from 'astro:assets';
import banquetImg from '../assets/images/06_banquet_hall.png';

const BOOKING_URL = "https://mobilebe.stayflexi.com/39879/?checkin=17-08-2026&num_nights=1&num_guests=2&source=google&hotel_id=39879";

const gridFeatures = [
  {
    title: "AV & Multimedia",
    subtitle: "Fully Equipped Setup",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M6 20.25h12m-12 0a2.25 2.25 0 01-2.25-2.25V6.75A2.25 2.25 0 016 4.5h12a2.25 2.25 0 012.25 2.25v11.25a2.25 2.25 0 01-2.25 2.25m-12 0h12" />`
  },
  {
    title: "High-Speed Network",
    subtitle: "High-Speed Wi-Fi Access",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12 18.75h.008v.008H12v-.008z" />`
  },
  {
    title: "Presentation Suite",
    subtitle: "Podium & Presentation Tools",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h16.5m-16.5 0L12 12m8.25-9v11.25A2.25 2.25 0 0118 16.5h-2.25m3.75-13.5L12 12m0 0v9" />`
  },
  {
    title: "Guest Comfort",
    subtitle: "Comfortable Seating & Ambience",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m16.5 0h-16.5m16.5 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 7.5" />`
  },
  {
    title: "Catering Support",
    subtitle: "Custom Menus & Refreshments",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z M9 9h6 M9 13h6 M9 17h3" />`
  },
  {
    title: "Event Assistance",
    subtitle: "Dedicated Team for a Seamless Experience",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385c.116.488-.41.868-.838.608l-4.71-2.852a.564.564 0 00-.58 0l-4.71 2.852c-.428.26-.954-.12-.838-.608l1.285-5.385a.562.562 0 00-.182-.557l-4.204-3.602c-.38-.325-.178-.948.32-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />`
  }
];
---

<section id="meetings-events" class="relative w-full bg-[#FAF7F3] text-[#1c0c30] py-12 sm:py-16 border-t border-[#e8ded0] overflow-hidden">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/4 left-1/3 w-96 h-96 bg-[#D4A373]/10 rounded-full filter blur-3xl pointer-events-none"></div>

  <div class="max-w-[1320px] w-full mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- SECTION HEADER -->
    <div class="max-w-xl mx-auto text-center mb-8 sm:mb-10 space-y-1.5">
      <!-- Eyebrow with Side Lines -->
      <div class="flex items-center justify-center gap-2.5 mb-0.5">
        <div class="w-8 h-[1px] bg-[#D4A373]"></div>
        <span class="text-[#b8860b] text-[10px] font-bold tracking-[0.2em] uppercase">
          BANQUET & CONFERENCES
        </span>
        <div class="w-8 h-[1px] bg-[#D4A373]"></div>
      </div>

      <!-- Serif Title -->
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold tracking-tight text-[#1c0c30]" style="font-family: 'Cormorant Garamond', serif;">
        Meetings & Events
      </h2>

      <!-- Subtitle -->
      <p class="text-[#554960] text-xs sm:text-sm font-normal max-w-lg mx-auto leading-relaxed">
        Host corporate conferences, private celebrations, and formal seminars in our versatile banquet venue at Delta Suites Beypore.
      </p>
    </div>

    <!-- MAIN 2-COLUMN GRID (WITH ENHANCED IMAGE HEIGHT TO ALIGN WITH RIGHT GRID) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center mb-8">
      
      <!-- LEFT COLUMN: BANQUET IMAGE WITH ENHANCED HEIGHT & OVERLAY CARD -->
      <div class="lg:col-span-6 relative">
        <div class="relative w-full h-64 sm:h-76 lg:h-88 rounded-[28px] overflow-hidden border border-[#e8ded0] shadow-[0_8px_30px_rgba(0,0,0,0.04)] bg-[#1c0c30]/5">
          <Image 
            src={banquetImg} 
            alt="75-Seater Banquet Hall" 
            class="w-full h-full object-cover" 
            loading="lazy" 
          />

          <!-- FLOATING WHITE OVERLAY CARD -->
          <div class="absolute bottom-4 left-4 right-4 sm:right-auto bg-white/95 backdrop-blur-md rounded-2xl p-3.5 sm:px-5 sm:py-3.5 border border-[#e8ded0] shadow-lg flex items-center gap-3.5 max-w-xs">
            <!-- Left Icon Emblem Circle -->
            <div class="w-10 h-10 rounded-full bg-[#FAF5ED] border border-[#EADBCE] text-[#b8860b] flex items-center justify-center shrink-0 shadow-2xs">
              <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.72m12 0a5.971 5.971 0 00-.941-3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
              </svg>
            </div>

            <!-- Text Stack -->
            <div>
              <span class="text-[11px] font-bold text-[#1c0c30] block leading-tight">
                Spacious Venue
              </span>
              <h3 class="text-base sm:text-lg font-serif font-bold text-[#b8860b] leading-tight" style="font-family: 'Cormorant Garamond', serif;">
                75-Seater Capacity
              </h3>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: 2x3 FEATURE GRID -->
      <div class="lg:col-span-6 relative">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-5 relative py-2">
          
          {gridFeatures.map((item, index) => (
            <div class={`flex items-start gap-3.5 p-2 relative ${
              index % 2 === 0 ? 'sm:border-r sm:border-[#e8ded0]/80 sm:pr-5' : 'sm:pl-3'
            }`}>
              <!-- Left Emblem Circle -->
              <div class="w-11 h-11 rounded-full bg-[#FAF5ED] border border-[#EADBCE] text-[#1c0c30] flex items-center justify-center shrink-0 shadow-2xs mt-0.5">
                <svg class="w-5 h-5 text-[#554960]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6">
                  <Fragment set:html={item.icon} />
                </svg>
              </div>

              <!-- Title & Subtitle Stack -->
              <div class="space-y-0.5 min-w-0">
                <h3 class="text-sm sm:text-base font-bold text-[#1c0c30] leading-tight truncate">
                  {item.title}
                </h3>
                <p class="text-[#6b5c77] text-xs font-normal leading-tight">
                  {item.subtitle}
                </p>
              </div>
            </div>
          ))}

          <!-- Horizontal Divider Lines -->
          <div class="hidden sm:block absolute top-1/3 left-0 right-0 h-[1px] bg-[#e8ded0]/70 pointer-events-none"></div>
          <div class="hidden sm:block absolute top-2/3 left-0 right-0 h-[1px] bg-[#e8ded0]/70 pointer-events-none"></div>

          <!-- Center Diamond Accent Dots -->
          <div class="hidden sm:block absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1.5 h-1.5 rotate-45 bg-[#D4A373]"></div>
          <div class="hidden sm:block absolute top-2/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1.5 h-1.5 rotate-45 bg-[#D4A373]"></div>

        </div>
      </div>

    </div>

    <!-- BOTTOM FULL-WIDTH DARK BANNER -->
    <div class="w-full bg-[#16062b] text-white rounded-[24px] p-5 sm:px-7 sm:py-5 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-lg border border-[#16062b]">
      
      <!-- Left Side: Icon + Text -->
      <div class="flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/15 text-[#D4A373] flex items-center justify-center shrink-0">
          <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
        </div>

        <div>
          <h3 class="text-sm sm:text-base font-serif font-bold text-white leading-tight" style="font-family: 'Cormorant Garamond', serif;">
            The ideal setting for every occasion.
          </h3>
          <p class="text-white/70 text-xs font-light">
            Conferences, seminars, celebrations — we make it memorable.
          </p>
        </div>
      </div>

      <!-- Vertical Separator (Desktop) -->
      <div class="hidden lg:block w-[1px] h-8 bg-white/15"></div>

      <!-- Right Side: Gold CTA Button -->
      <a 
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group w-full sm:w-auto bg-[#b8860b] hover:bg-[#D4A373] text-white font-bold text-xs uppercase tracking-[0.18em] py-3.5 px-7 rounded-xl transition-all duration-300 shadow-md inline-flex items-center justify-center gap-2 shrink-0 cursor-pointer"
      >
        <span>EXPLORE OUR SPACES</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>

    </div>

  </div>
</section>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap');
</style>
