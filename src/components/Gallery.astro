---
import { Image } from 'astro:assets';

// Asset imports
import galleryProperty from '../assets/images/gallery_property.png';
import galleryLobby from '../assets/images/gallery_lobby.png';
import galleryExterior from '../assets/images/gallery_exterior.png';
import galleryFood from '../assets/images/gallery_food.png';
import roomPresidential from '../assets/images/room_presidential.png';
import roomDeluxe from '../assets/images/room_deluxe.png';
import poolImg from '../assets/images/04_pool.png';
import kidsPoolImg from '../assets/images/kids_pool.png';
import restaurantImg from '../assets/images/03_restaurant.png';
import gymImg from '../assets/images/05_fitness.png';
import diningBreakfast from '../assets/images/dining_breakfast.png';
import familyTimeImg from '../assets/images/family_time.png';

const categories = [
  { id: 'all', label: 'All' },
  { id: 'property', label: 'Property' },
  { id: 'rooms', label: 'Rooms' },
  { id: 'pool', label: 'Pool' },
  { id: 'kids-pool', label: 'Kids Pool' },
  { id: 'restaurant', label: 'Restaurant' },
  { id: 'gym', label: 'Gym' },
  { id: 'lobby', label: 'Lobby' },
  { id: 'exterior', label: 'Exterior' },
  { id: 'food', label: 'Food' }
];

const galleryItems = [
  {
    id: 'item-1',
    category: 'property',
    categoryName: 'Property',
    title: 'Delta Suites Architectural Overview',
    description: 'A panoramic view of our tranquil resort sanctuary nestled in Beypore.',
    image: galleryProperty
  },
  {
    id: 'item-2',
    category: 'rooms',
    categoryName: 'Rooms',
    title: 'Presidential Master Suite',
    description: 'Elegantly furnished luxury master suite featuring king-size bedding and plush lounge.',
    image: roomPresidential
  },
  {
    id: 'item-3',
    category: 'pool',
    categoryName: 'Pool',
    title: 'Serene Infinity Pool',
    description: 'Bask under tropical palms beside crystal-clear swimming pool waters.',
    image: poolImg
  },
  {
    id: 'item-4',
    category: 'kids-pool',
    categoryName: 'Kids Pool',
    title: 'Dedicated Kids & Family Pool',
    description: 'Safe, shallow water splash pool crafted for younger family guests.',
    image: kidsPoolImg
  },
  {
    id: 'item-5',
    category: 'restaurant',
    categoryName: 'Restaurant',
    title: 'Grand Dining Pavilion',
    description: 'Atmospheric culinary hall serving Malabar specialties and international gastronomy.',
    image: restaurantImg
  },
  {
    id: 'item-6',
    category: 'gym',
    categoryName: 'Gym',
    title: 'State-of-the-Art Fitness Center',
    description: 'Fully equipped modern gym featuring premium strength and cardio equipment.',
    image: gymImg
  },
  {
    id: 'item-7',
    category: 'lobby',
    categoryName: 'Lobby',
    title: 'Grand Reception & Lounge',
    description: 'Opulent lobby entrance with marble flooring, custom chandelier, and concierge.',
    image: galleryLobby
  },
  {
    id: 'item-8',
    category: 'exterior',
    categoryName: 'Exterior',
    title: 'Twilight Resort Facade',
    description: 'Stately exterior architecture lit by warm ambient night illumination.',
    image: galleryExterior
  },
  {
    id: 'item-9',
    category: 'food',
    categoryName: 'Food',
    title: 'Gourmet Culinary Artistry',
    description: 'Exquisitely plated chef signature dishes crafted with authentic local spices.',
    image: galleryFood
  },
  {
    id: 'item-10',
    category: 'rooms',
    categoryName: 'Rooms',
    title: 'Deluxe Suite Interior',
    description: 'Thoughtfully designed room with contemporary aesthetics and modern amenities.',
    image: roomDeluxe
  },
  {
    id: 'item-11',
    category: 'food',
    categoryName: 'Food',
    title: 'Breakfast Spread & Fresh Juices',
    description: 'Sumptuous morning buffet featuring fresh tropical fruits and hot delicacies.',
    image: diningBreakfast
  },
  {
    id: 'item-12',
    category: 'property',
    categoryName: 'Property',
    title: 'Lush Courtyard Gardens',
    description: 'Serene garden pathways ideal for peaceful strolls and relaxing family moments.',
    image: familyTimeImg
  }
];
---

<section id="gallery" class="relative w-full bg-[#FAF7F3] py-16 sm:py-24 overflow-hidden border-t border-[#e8ded0]">
  
  <!-- Ambient Background Glows -->
  <div class="absolute top-1/4 left-1/3 w-96 h-96 bg-[#D4A373]/10 rounded-full filter blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 right-1/4 w-80 h-80 bg-[#1c0c30]/5 rounded-full filter blur-3xl pointer-events-none"></div>

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-10 sm:mb-14 flex flex-col items-center">
      <span class="text-[#b8860b] text-xs font-bold tracking-[0.25em] uppercase mb-2">
        GALLERY
      </span>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl text-[#1c0c30] font-serif font-bold tracking-tight mb-3" style="font-family: 'Cormorant Garamond', serif;">
        Inside Delta Suites
      </h2>

      <div class="flex items-center gap-2 justify-center mb-3">
        <div class="w-10 h-[1px] bg-[#D4A373]"></div>
        <div class="w-1.5 h-1.5 rotate-45 bg-[#D4A373]"></div>
        <div class="w-10 h-[1px] bg-[#D4A373]"></div>
      </div>

      <p class="text-[#554960] text-xs sm:text-sm font-normal leading-relaxed max-w-lg">
        Immerse yourself in the elegance of Delta Suites. Explore our rooms, infinity pool, fine dining, and serene spaces.
      </p>
    </div>

    <!-- Category Tabs Navigation -->
    <div class="mb-10 sm:mb-12">
      <div class="flex items-center justify-start md:justify-center gap-2 overflow-x-auto pb-3 pt-1 px-1 scrollbar-none no-scrollbar">
        {categories.map((cat, index) => (
          <button
            type="button"
            data-gallery-tab={cat.id}
            class={`gallery-tab-btn whitespace-nowrap px-4 py-2 sm:px-5 sm:py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 cursor-pointer border shadow-xs ${
              index === 0
                ? 'active-tab bg-[#1c0c30] text-white border-[#1c0c30] shadow-md'
                : 'bg-[#FAF5ED] text-[#554960] border-[#EADBCE] hover:border-[#D4A373] hover:text-[#1c0c30] hover:bg-white'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Gallery Grid -->
    <div id="galleryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {galleryItems.map((item, index) => (
        <div
          data-gallery-item
          data-category={item.category}
          data-index={index}
          data-title={item.title}
          data-category-name={item.categoryName}
          data-desc={item.description}
          data-image-src={item.image.src}
          class="gallery-card group bg-white rounded-[24px] p-3.5 border border-[#e8ded0] shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_35px_rgba(212,163,115,0.18)] hover:border-[#D4A373] transition-all duration-500 cursor-pointer overflow-hidden flex flex-col transform hover:-translate-y-1.5"
        >
          <!-- Image Container with Aspect Ratio -->
          <div class="relative w-full aspect-[4/3] rounded-[18px] overflow-hidden bg-[#1c0c30]/5 mb-3 border border-[#e8ded0]/60">
            <Image
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover transform group-hover:scale-108 transition-transform duration-700 ease-out"
              loading="lazy"
            />

            <!-- Gradient Vignette -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#1c0c30]/75 via-[#1c0c30]/10 to-transparent opacity-60 group-hover:opacity-85 transition-opacity duration-500 pointer-events-none"></div>

            <!-- Top Category Pill Badge -->
            <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-[#1c0c30] text-[10px] font-bold tracking-wider px-3 py-1 rounded-full uppercase flex items-center gap-1.5 border border-[#e8ded0] shadow-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-[#b8860b]"></span>
              <span>{item.categoryName}</span>
            </div>

            <!-- Expand / Lightbox Hover Button Overlay -->
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-[#1c0c30]/40 backdrop-blur-[2px]">
              <div class="w-12 h-12 rounded-full bg-white text-[#1c0c30] group-hover:bg-[#b8860b] group-hover:text-white flex items-center justify-center shadow-xl transform scale-75 group-hover:scale-100 transition-all duration-300">
                <!-- Expand Icon -->
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </div>

            <!-- Bottom Left Title Overlay inside Image -->
            <div class="absolute bottom-3 left-3 right-3 text-white">
              <h3 class="text-base sm:text-lg font-serif font-bold leading-tight drop-shadow-sm group-hover:text-[#D4A373] transition-colors" style="font-family: 'Cormorant Garamond', serif;">
                {item.title}
              </h3>
            </div>
          </div>

          <!-- Bottom Meta Text -->
          <div class="px-2 pb-1.5 flex items-center justify-between">
            <p class="text-[#554960] text-xs leading-relaxed line-clamp-1">
              {item.description}
            </p>
            <span class="text-[#b8860b] text-xs font-bold ml-2 shrink-0 group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
              <span>Expand</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </span>
          </div>

        </div>
      ))}
    </div>

    <!-- CTA Button Container -->
    <div class="mt-12 sm:mt-16 text-center">
      <button
        id="viewFullGalleryBtn"
        type="button"
        class="inline-flex items-center gap-3 bg-[#1c0c30] hover:bg-[#b8860b] text-white font-bold text-xs uppercase tracking-[0.2em] py-4 px-8 sm:px-10 rounded-full transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5 group cursor-pointer border border-[#1c0c30] hover:border-[#b8860b]"
      >
        <span>VIEW FULL GALLERY</span>
        <div class="w-7 h-7 rounded-full bg-white/10 group-hover:bg-white group-hover:text-[#b8860b] flex items-center justify-center transition-colors">
          <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </div>
      </button>
    </div>

  </div>

  <!-- LIGHTBOX / EXPANDABLE IMAGE MODAL -->
  <div
    id="galleryLightbox"
    class="fixed inset-0 z-50 bg-[#0e0618]/90 backdrop-blur-xl flex items-center justify-center p-4 sm:p-6 lg:p-10 opacity-0 pointer-events-none transition-all duration-300 select-none"
    role="dialog"
    aria-modal="true"
    aria-label="Image Lightbox"
  >
    <!-- Close Button -->
    <button
      id="closeLightbox"
      type="button"
      aria-label="Close Lightbox"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 z-50 w-11 h-11 rounded-full bg-white/10 hover:bg-[#b8860b] text-white flex items-center justify-center border border-white/20 transition-all duration-300 cursor-pointer shadow-lg hover:scale-105"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Navigation Prev Button -->
    <button
      id="lightboxPrev"
      type="button"
      aria-label="Previous Image"
      class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-40 w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-white/10 hover:bg-[#b8860b] text-white flex items-center justify-center border border-white/20 transition-all duration-300 cursor-pointer shadow-lg hover:scale-110"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>

    <!-- Navigation Next Button -->
    <button
      id="lightboxNext"
      type="button"
      aria-label="Next Image"
      class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-40 w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-white/10 hover:bg-[#b8860b] text-white flex items-center justify-center border border-white/20 transition-all duration-300 cursor-pointer shadow-lg hover:scale-110"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>

    <!-- Modal Content Box -->
    <div
      id="lightboxContainer"
      class="max-w-5xl w-full flex flex-col items-center justify-center relative transform scale-95 transition-all duration-300 my-auto"
    >
      <!-- Image Display Frame -->
      <div class="relative max-h-[72vh] w-full flex items-center justify-center rounded-2xl overflow-hidden shadow-2xl border border-white/15 bg-black/40">
        <img
          id="lightboxImage"
          src=""
          alt=""
          class="max-h-[72vh] max-w-full object-contain transition-all duration-300"
        />

        <!-- Top Counter & Category Floating Bar -->
        <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
          <span
            id="lightboxCategory"
            class="bg-[#1c0c30]/80 backdrop-blur-md text-[#D4A373] border border-[#D4A373]/40 text-[10px] sm:text-xs font-bold tracking-widest px-3.5 py-1.5 rounded-full uppercase"
          ></span>

          <span
            id="lightboxCounter"
            class="bg-black/60 backdrop-blur-md text-white/90 border border-white/20 text-[10px] sm:text-xs font-semibold px-3 py-1.5 rounded-full tracking-wider"
          ></span>
        </div>
      </div>

      <!-- Bottom Caption Bar -->
      <div class="mt-4 w-full text-center px-4">
        <h3
          id="lightboxTitle"
          class="text-xl sm:text-2xl lg:text-3xl font-serif font-bold text-white tracking-tight leading-tight mb-1"
          style="font-family: 'Cormorant Garamond', serif;"
        ></h3>
        <p
          id="lightboxDesc"
          class="text-xs sm:text-sm text-gray-300 max-w-xl mx-auto font-normal leading-relaxed"
        ></p>
      </div>

    </div>
  </div>

</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Elements
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-gallery-tab]');
    const cards = document.querySelectorAll<HTMLElement>('[data-gallery-item]');
    const viewFullBtn = document.getElementById('viewFullGalleryBtn');

    // Lightbox elements
    const lightbox = document.getElementById('galleryLightbox');
    const lightboxContainer = document.getElementById('lightboxContainer');
    const lightboxImg = document.getElementById('lightboxImage') as HTMLImageElement;
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxDesc = document.getElementById('lightboxDesc');
    const lightboxCategory = document.getElementById('lightboxCategory');
    const lightboxCounter = document.getElementById('lightboxCounter');
    
    const closeBtn = document.getElementById('closeLightbox');
    const prevBtn = document.getElementById('lightboxPrev');
    const nextBtn = document.getElementById('lightboxNext');

    let currentVisibleCards: HTMLElement[] = Array.from(cards);
    let currentImageIndex = 0;

    // Filter logic
    const filterGallery = (category: string) => {
      // Update Tab Styles
      tabButtons.forEach(btn => {
        const cat = btn.getAttribute('data-gallery-tab');
        if (cat === category) {
          btn.classList.add('active-tab', 'bg-[#1c0c30]', 'text-white', 'border-[#1c0c30]', 'shadow-md');
          btn.classList.remove('bg-[#FAF5ED]', 'text-[#554960]', 'border-[#EADBCE]', 'hover:bg-white');
        } else {
          btn.classList.remove('active-tab', 'bg-[#1c0c30]', 'text-white', 'border-[#1c0c30]', 'shadow-md');
          btn.classList.add('bg-[#FAF5ED]', 'text-[#554960]', 'border-[#EADBCE]', 'hover:bg-white');
        }
      });

      // Filter Cards
      currentVisibleCards = [];
      cards.forEach(card => {
        const itemCategory = card.getAttribute('data-category');
        if (category === 'all' || itemCategory === category) {
          card.style.display = 'flex';
          card.classList.remove('scale-95', 'opacity-0');
          card.classList.add('scale-100', 'opacity-100');
          currentVisibleCards.push(card);
        } else {
          card.classList.remove('scale-100', 'opacity-100');
          card.classList.add('scale-95', 'opacity-0');
          setTimeout(() => {
            if (!card.classList.contains('opacity-100')) {
              card.style.display = 'none';
            }
          }, 200);
        }
      });
    };

    // Tab Button Click Listener
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-gallery-tab') || 'all';
        filterGallery(category);
      });
    });

    // Lightbox Logic
    const updateLightboxContent = (index: number) => {
      if (currentVisibleCards.length === 0) return;
      
      currentImageIndex = (index + currentVisibleCards.length) % currentVisibleCards.length;
      const card = currentVisibleCards[currentImageIndex];

      const imgSrc = card.getAttribute('data-image-src') || '';
      const title = card.getAttribute('data-title') || '';
      const desc = card.getAttribute('data-desc') || '';
      const categoryName = card.getAttribute('data-category-name') || '';

      if (lightboxImg) {
        lightboxImg.style.opacity = '0.4';
        setTimeout(() => {
          lightboxImg.src = imgSrc;
          lightboxImg.alt = title;
          lightboxImg.style.opacity = '1';
        }, 150);
      }

      if (lightboxTitle) lightboxTitle.textContent = title;
      if (lightboxDesc) lightboxDesc.textContent = desc;
      if (lightboxCategory) lightboxCategory.textContent = categoryName;
      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentImageIndex + 1} / ${currentVisibleCards.length}`;
      }
    };

    const openLightbox = (card: HTMLElement) => {
      const indexInVisible = currentVisibleCards.indexOf(card);
      const targetIndex = indexInVisible !== -1 ? indexInVisible : 0;

      updateLightboxContent(targetIndex);

      document.body.style.overflow = 'hidden';
      lightbox?.classList.remove('opacity-0', 'pointer-events-none');
      lightbox?.classList.add('opacity-100', 'pointer-events-auto');

      lightboxContainer?.classList.remove('scale-95');
      lightboxContainer?.classList.add('scale-100');
    };

    const closeLightboxModal = () => {
      lightboxContainer?.classList.remove('scale-100');
      lightboxContainer?.classList.add('scale-95');

      lightbox?.classList.remove('opacity-100', 'pointer-events-auto');
      lightbox?.classList.add('opacity-0', 'pointer-events-none');

      setTimeout(() => {
        document.body.style.overflow = '';
      }, 250);
    };

    // Attach click listeners to cards
    cards.forEach(card => {
      card.addEventListener('click', () => {
        openLightbox(card);
      });
    });

    // Lightbox Controls
    closeBtn?.addEventListener('click', closeLightboxModal);

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateLightboxContent(currentImageIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateLightboxContent(currentImageIndex + 1);
    });

    // Close when clicking overlay backdrop
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightboxModal();
      }
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('opacity-100')) return;

      if (e.key === 'Escape') {
        closeLightboxModal();
      } else if (e.key === 'ArrowLeft') {
        updateLightboxContent(currentImageIndex - 1);
      } else if (e.key === 'ArrowRight') {
        updateLightboxContent(currentImageIndex + 1);
      }
    });

    // VIEW FULL GALLERY CTA button logic
    viewFullBtn?.addEventListener('click', () => {
      // Reset filter to ALL
      filterGallery('all');
      
      // Open Lightbox starting from 0 or scroll smoothly
      const gallerySection = document.getElementById('gallery');
      gallerySection?.scrollIntoView({ behavior: 'smooth' });

      setTimeout(() => {
        if (currentVisibleCards.length > 0) {
          openLightbox(currentVisibleCards[0]);
        }
      }, 400);
    });
  });
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap');
  
  /* Hide scrollbar for category tabs */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
