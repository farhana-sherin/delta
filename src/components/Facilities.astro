---
const BOOKING_URL = "https://mobilebe.stayflexi.com/39879/?checkin=17-08-2026&num_nights=1&num_guests=2&source=google&hotel_id=39879";

const services = [
  {
    id: "wifi",
    title: "WiFi & Internet",
    description: "Reliable high-speed internet access across guest rooms and common areas.",
    icon: `
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12 18.75h.008v.008H12v-.008z" />
      </svg>
    `
  },
  {
    id: "room-service",
    title: "Room Service",
    description: "Delicious meals delivered to your room during designated hours.",
    icon: `
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z M9 9h6 M9 13h6 M9 17h3" />
      </svg>
    `
  },
  {
    id: "housekeeping",
    title: "Daily Housekeeping",
    description: "Clean, well-maintained rooms for a fresh and comfortable stay every day.",
    icon: `
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
      </svg>
    `
  },
  {
    id: "front-desk",
    title: "Front Desk Assistance",
    description: "Our friendly team is available 24/7 to assist with your queries and requests.",
    icon: `
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    `
  },
  {
    id: "secure-access",
    title: "Secure Room Access",
    description: "RFID-enabled door locks ensure your safety and complete peace of mind.",
    icon: `
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
      </svg>
    `
  },
  {
    id: "comfort-essentials",
    title: "Comfort Essentials",
    description: "Premium toiletries, soft linens and all the little things you need for a relaxing stay.",
    icon: `
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
      </svg>
    `
  }
];
---

<section id="facilities" class="relative w-full bg-[#FAF7F3] py-20 sm:py-28 overflow-hidden border-t border-[#e8ded0]">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/4 right-1/3 w-96 h-96 bg-[#D4A373]/10 rounded-full filter blur-3xl pointer-events-none"></div>

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- LEFT COLUMN: Clean Header Block without Image (4 cols out of 12) -->
      <div class="lg:col-span-4 flex flex-col justify-center fac-reveal fac-fade-left">
        
        <!-- Eyebrow Tag & Ornament -->
        <div class="flex items-center gap-2 mb-3">
          <span class="text-[#b8860b] text-[11px] font-bold tracking-[0.25em] uppercase">
            WHAT WE PROVIDE
          </span>
          <div class="flex items-center gap-1">
            <div class="w-8 h-[1px] bg-[#D4A373]"></div>
            <span class="text-[#D4A373] text-xs">✦</span>
          </div>
        </div>

        <!-- Main Title -->
        <h2 class="text-4xl sm:text-5xl lg:text-[54px] text-[#1c0c30] font-serif font-bold tracking-tight leading-[1.08] mb-4" style="font-family: 'Cormorant Garamond', serif;">
          Essential<br />Services
        </h2>

        <!-- Gold Accent Bar -->
        <div class="flex items-center gap-2 mb-4">
          <div class="w-10 h-[1.5px] bg-[#D4A373]"></div>
          <div class="w-1.5 h-1.5 rotate-45 bg-[#D4A373]"></div>
        </div>

        <!-- Paragraph -->
        <p class="text-[#554960] text-sm sm:text-base font-normal leading-relaxed max-w-sm mb-7">
          Thoughtfully curated services to make your stay comfortable, convenient and memorable.
        </p>

        <!-- CTA Pill Button -->
        <div>
          <a 
            href={BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-[#1c0c30] hover:bg-[#b8860b] text-white font-bold text-xs uppercase tracking-[0.18em] py-3.5 px-7 rounded-full transition-all duration-300 shadow-md hover:shadow-xl group cursor-pointer transform hover:-translate-y-0.5"
          >
            <span>RESERVE YOUR STAY</span>
            <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        </div>

      </div>

      <!-- RIGHT COLUMN: 2x3 Grid of 6 Vertical Cards (8 cols out of 12) -->
      <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-5 lg:gap-6">
        {services.map((item, index) => (
          <div 
            style={`--stagger-index: ${index};`}
            class="fac-reveal fac-card-stagger group bg-white rounded-2xl p-6 border border-[#e8ded0]/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-xl hover:border-[#D4A373] transition-all duration-300 hover:-translate-y-1 flex flex-col items-center text-center relative overflow-hidden cursor-pointer min-h-[220px] justify-center"
          >
            
            <!-- Icon Stack with Off-center Accent Glow Circle -->
            <div class="relative mb-4 flex items-center justify-center">
              <div class="absolute -top-1 -right-1 w-6 h-6 rounded-full bg-[#D4A373]/20 pointer-events-none"></div>
              <div class="w-12 h-12 rounded-full bg-[#1c0c30] text-white flex items-center justify-center relative z-10 group-hover:bg-[#b8860b] transition-colors duration-300 shadow-sm">
                <Fragment set:html={item.icon} />
              </div>
            </div>

            <!-- Card Title -->
            <h3 class="text-lg font-serif font-bold text-[#1c0c30] group-hover:text-[#b8860b] transition-colors leading-tight" style="font-family: 'Cormorant Garamond', serif;">
              {item.title}
            </h3>

            <!-- Gold Divider Line -->
            <div class="w-6 h-[1.5px] bg-[#D4A373] my-2.5 group-hover:w-10 transition-all duration-300"></div>

            <!-- Description -->
            <p class="text-[#554960] text-xs leading-relaxed font-normal">
              {item.description}
            </p>

          </div>
        ))}
      </div>

    </div>

  </div>

</section>

<script is:inline>
  (function() {
    var section = document.getElementById('facilities');
    if (!section) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('fac-visible');
        } else {
          entry.target.classList.remove('fac-visible');
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap');

  .fac-reveal {
    opacity: 0;
    will-change: transform, opacity;
    transition: transform 1.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .fac-fade-left { transform: translateX(-40px); }
  .fac-card-stagger { transform: translateY(45px); }

  #facilities.fac-visible .fac-fade-left {
    opacity: 1;
    transform: translateX(0);
  }

  #facilities.fac-visible .fac-card-stagger {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--stagger-index, 0) * 0.14s + 0.15s);
  }
</style>
