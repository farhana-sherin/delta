---
import astroLogo from '../assets/astro.svg';
---

<div class="relative min-h-screen flex flex-col justify-center overflow-hidden bg-slate-950">
    <!-- Ambient Background Gradients -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <div class="absolute -top-[10%] -left-[10%] w-[50vw] h-[50vw] bg-purple-600/20 rounded-full blur-[120px] mix-blend-screen"></div>
        <div class="absolute top-[20%] -right-[10%] w-[60vw] h-[60vw] bg-blue-600/20 rounded-full blur-[150px] mix-blend-screen"></div>
        <div class="absolute -bottom-[20%] left-[20%] w-[50vw] h-[50vw] bg-pink-500/20 rounded-full blur-[120px] mix-blend-screen"></div>
        
        <!-- Subtle noise texture -->
        <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 contrast-150 mix-blend-overlay"></div>
    </div>

    <!-- Main Content -->
    <main class="relative z-10 w-full max-w-6xl mx-auto px-6 py-20 flex flex-col items-center text-center">
        
        <!-- Top Badge -->
        <div class="mb-10 inline-flex items-center gap-3 px-4 py-2 rounded-full bg-slate-900/50 border border-slate-700/50 backdrop-blur-md shadow-2xl text-sm font-medium text-slate-300 transition-transform hover:scale-105 cursor-default">
            <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-purple-500"></span>
            </span>
            Astro 5 + Tailwind CSS v4
        </div>
        
        <!-- Hero Headline -->
        <h1 class="text-5xl sm:text-6xl md:text-8xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-br from-white via-white to-slate-400 mb-8 drop-shadow-sm leading-tight">
            Perfectly <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400">Styled.</span>
        </h1>
        
        <!-- Subheadline -->
        <p class="text-lg md:text-2xl text-slate-400 mb-12 max-w-3xl leading-relaxed font-light">
            Experience the stunning performance of Astro seamlessly combined with the rapid styling power of Tailwind CSS. Craft glassmorphic UIs, fluid animations, and robust layouts effortlessly.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center gap-5 w-full justify-center mb-24">
            <a href="https://docs.astro.build" class="group relative px-8 py-4 w-full sm:w-auto rounded-2xl bg-slate-100 text-slate-950 font-semibold transition-all hover:scale-105 hover:shadow-[0_0_40px_-10px_rgba(255,255,255,0.4)] duration-300 overflow-hidden">
                <span class="relative z-10 flex items-center justify-center gap-2">
                    Read the Docs
                    <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </span>
                <div class="absolute inset-0 bg-gradient-to-r from-purple-200 to-blue-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </a>
            
            <a href="https://astro.build/chat" class="group px-8 py-4 w-full sm:w-auto rounded-2xl bg-white/5 border border-white/10 text-white font-semibold backdrop-blur-md transition-all hover:bg-white/10 hover:border-white/20 hover:scale-105 duration-300 flex items-center justify-center gap-2 shadow-xl shadow-black/20">
                Join Community
                <svg class="w-6 h-6 text-[#5865F2]" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.492c-1.53-.69-3.17-1.2-4.885-1.49a.075.075 0 0 0-.079.036c-.21.369-.444.85-.608 1.23a18.566 18.566 0 0 0-5.487 0 12.36 12.36 0 0 0-.617-1.23.077.077 0 0 0-.079-.035C6.85 3.29 5.21 3.8 3.68 4.492a.07.07 0 0 0-.032.027C.533 9.093-.32 13.555.099 17.961a.08.08 0 0 0 .031.057 19.908 19.908 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.046 13.046 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.44a.061.061 0 0 0-.031-.028zM8.02 15.278c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </a>
        </div>

        <!-- Features Bento Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full text-left relative z-10">
            <!-- Large Card -->
            <div class="col-span-1 md:col-span-2 group p-8 sm:p-10 rounded-[2rem] bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 transition-all duration-500 shadow-2xl relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-2xl bg-purple-500/20 flex items-center justify-center mb-8 border border-purple-500/30">
                        <svg class="w-7 h-7 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <h3 class="text-3xl font-bold text-white mb-4">Lightning Fast <span class="bg-purple-500/20 text-purple-300 text-sm py-1 px-3 rounded-full ml-2 align-middle border border-purple-500/20">Zero JS</span></h3>
                    <p class="text-slate-400 text-lg leading-relaxed max-w-lg">Astro's zero-JS architecture combined with Tailwind's utility-first approach ensures your applications load instantly and consistently score perfect Lighthouse metrics.</p>
                </div>
            </div>

            <!-- Small Card 1 -->
            <div class="col-span-1 group p-8 sm:p-10 rounded-[2rem] bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 transition-all duration-500 shadow-2xl relative overflow-hidden flex flex-col justify-between">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-2xl bg-blue-500/20 flex items-center justify-center mb-8 border border-blue-500/30">
                        <svg class="w-7 h-7 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-3">Beautiful UX</h3>
                    <p class="text-slate-400 leading-relaxed">Rich glassmorphism, dynamic gradients, and smooth micro-interactions that elevate your product.</p>
                </div>
            </div>
            
            <!-- Bottom Full Card -->
            <div class="col-span-1 md:col-span-3 group p-8 sm:p-10 rounded-[2rem] bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 transition-all duration-500 shadow-2xl relative overflow-hidden mt-2">
                <div class="absolute inset-0 bg-gradient-to-br from-pink-500/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
                    <div>
                        <h3 class="text-2xl font-bold text-white mb-3">Tailwind v4 Powered</h3>
                        <p class="text-slate-400 leading-relaxed max-w-2xl">Taking advantage of the new CSS-first configuration, improved performance, and native CSS cascading variables introduced in the latest version.</p>
                    </div>
                    <div class="font-mono text-sm bg-slate-900/60 p-4 rounded-xl border border-slate-700 text-pink-300 w-full md:w-auto shadow-inner">
                        <span class="text-slate-500">@import</span> "tailwindcss";
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
