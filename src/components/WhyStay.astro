---
import { Image } from 'astro:assets';
import luxuryRoomImg from '../assets/images/02_room.webp';

const BOOKING_URL = "https://mobilebe.stayflexi.com/39879/?checkin=17-08-2026&num_nights=1&num_guests=2&source=google&hotel_id=39879";

const whyStayReasons = [
  {
    num: "01",
    id: "prime-location",
    title: "Prime Location",
    description: "Explore Beypore and Kozhikode conveniently from our location.",
    icon: `
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
      </svg>
    `
  },
  {
    num: "02",
    id: "comfortable-rooms",
    title: "Comfortable Rooms",
    description: "Thoughtfully designed rooms with essential modern amenities.",
    icon: `
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v11m0-4h18m0 4v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v2m4-6h3a1 1 0 001-1V7a1 1 0 00-1-1H7a1 1 0 00-1 1v1a1 1 0 001 1zm8 0h3a1 1 0 001-1V7a1 1 0 00-1-1h-3a1 1 0 00-1 1v1a1 1 0 001 1z" />
      </svg>
    `
  },
  {
    num: "03",
    id: "family-friendly",
    title: "Family Friendly",
    description: "Swimming pool and separate kids pool make the property suitable for family stays.",
    icon: `
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
      </svg>
    `
  },
  {
    num: "04",
    id: "leisure-facilities",
    title: "Leisure Facilities",
    description: "Enjoy our swimming pool and indoor gym during your stay.",
    icon: `
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 15c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M3 19c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M15 5.5a2.5 2.5 0 10-5 0v3.5h5V5.5z" />
      </svg>
    `
  },
  {
    num: "05",
    id: "convenient-dining",
    title: "Convenient Dining",
    description: "Enjoy meals without having to leave the property.",
    icon: `
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z M9 9h6 M9 13h6 M9 17h3" />
      </svg>
    `
  },
  {
    num: "06",
    id: "warm-hospitality",
    title: "Warm Hospitality",
    description: "Our team is committed to making every stay comfortable and hassle-free.",
    icon: `
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
      </svg>
    `
  }
];
---

<section id="why-stay" class="relative w-full bg-[#FAF7F3] py-12 sm:py-16 overflow-hidden border-t border-[#e8ded0]">
  
  <!-- Ambient Gold Glow -->
  <div class="absolute top-1/3 left-1/4 w-[32rem] h-[32rem] bg-[#D4A373]/10 rounded-full filter blur-3xl pointer-events-none"></div>

  <div class="max-w-[1400px] w-full mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-stretch">
      
      <!-- LEFT COLUMN: Compact Header & Photo Frame (5 cols out of 12) -->
      <div class="lg:col-span-5 flex flex-col justify-between py-1 why-reveal why-fade-left">
        
        <!-- Header Text -->
        <div class="mb-3">
          <!-- Eyebrow Tag -->
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-[#b8860b] text-[11px] font-bold tracking-[0.25em] uppercase">
              WHY CHOOSE US
            </span>
            <div class="w-6 h-[1px] bg-[#D4A373]"></div>
            <span class="text-[#D4A373] text-xs">✦</span>
          </div>

          <!-- Main Title -->
          <h2 class="text-3xl sm:text-4xl text-[#1c0c30] font-serif font-bold tracking-tight leading-[1.08] mb-2" style="font-family: 'Cormorant Garamond', serif;">
            Why Stay With Us?
          </h2>

          <!-- Paragraph -->
          <p class="text-[#554960] text-xs sm:text-sm font-normal leading-relaxed max-w-sm mb-3">
            Designed for guests seeking serene luxury, modern convenience, and genuine Malabar hospitality in Beypore.
          </p>

          <!-- CTA Pill Button -->
          <a 
            href={BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#1c0c30] hover:bg-[#b8860b] text-white font-bold text-[10px] uppercase tracking-[0.18em] py-2.5 px-5 rounded-full transition-all duration-300 shadow-sm hover:shadow-lg group cursor-pointer transform hover:-translate-y-0.5"
          >
            <span>RESERVE YOUR SUITE</span>
            <svg class="w-3 h-3 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- ARCHITECTURAL IMAGE FRAME MATCHING TARGET SCREENSHOT HEIGHT -->
        <div class="relative w-full h-[250px] sm:h-[280px] lg:h-[300px] rounded-2xl rounded-tr-3xl overflow-hidden bg-[#1c0c30]/5 border border-[#e8ded0] shadow-md group">
          <Image 
            src={luxuryRoomImg} 
            alt="Delta Suites Luxury Room Experience" 
            class="w-full h-full object-cover transform group-hover:scale-108 transition-transform duration-700 ease-out" 
            loading="lazy" 
          />
          
          <!-- Top Left Floating Pill Badge -->
          <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-[#1c0c30] text-[9px] font-bold tracking-wider px-3 py-1 rounded-full uppercase flex items-center gap-1 border border-[#e8ded0] shadow-sm">
            <span class="text-[#b8860b]">★</span>
            <span>EXCELLENCE IN HOSPITALITY</span>
          </div>

          <!-- Bottom Right Circular Emblem -->
          <div class="absolute bottom-2.5 right-2.5 w-9 h-9 rounded-full bg-[#1c0c30] border border-white text-[#D4A373] flex items-center justify-center shadow-lg group-hover:bg-[#b8860b] group-hover:text-white transition-colors duration-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: 6 Compact Feature Cards (7 cols out of 12) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-4.5">
        {whyStayReasons.map((item, index) => (
          <div 
            style={`--stagger-index: ${index};`}
            class="why-reveal why-card-stagger group bg-white rounded-2xl p-4.5 sm:p-5 border border-[#e8ded0]/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-xl hover:border-[#D4A373] transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between cursor-pointer min-h-[160px] relative overflow-hidden"
          >
            
            <div>
              <!-- Top Row: Circle Avatar & Number -->
              <div class="flex items-center justify-between gap-3 mb-2.5">
                <div class="w-10 h-10 rounded-full bg-[#1c0c30] text-[#D4A373] group-hover:bg-[#b8860b] group-hover:text-white flex items-center justify-center transition-colors duration-300 shadow-sm shrink-0">
                  <Fragment set:html={item.icon} />
                </div>
                <span class="text-xs font-serif font-bold text-[#b8860b]/60 group-hover:text-[#b8860b] transition-colors" style="font-family: 'Cormorant Garamond', serif;">
                  {item.num}
                </span>
              </div>

              <!-- Title -->
              <h3 class="text-base sm:text-lg font-serif font-bold text-[#1c0c30] group-hover:text-[#b8860b] transition-colors leading-tight mb-1" style="font-family: 'Cormorant Garamond', serif;">
                {item.title}
              </h3>

              <!-- Gold Divider Line -->
              <div class="w-6 h-[1.5px] bg-[#D4A373] my-1.5 group-hover:w-10 group-hover:bg-[#b8860b] transition-all duration-300"></div>

              <!-- Description -->
              <p class="text-[#554960] text-xs leading-relaxed font-normal">
                {item.description}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>

</section>

<script is:inline>
  (function() {
    var section = document.getElementById('why-stay');
    if (!section) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('why-visible');
        } else {
          entry.target.classList.remove('why-visible');
        }
      });
    }, { threshold: 0.15 });

    observer.observe(section);
  })();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap');

  .why-reveal {
    opacity: 0;
    will-change: transform, opacity;
    transition: transform 1.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .why-fade-left { transform: translateX(-40px); }
  .why-card-stagger { transform: translateY(45px); }

  #why-stay.why-visible .why-fade-left {
    opacity: 1;
    transform: translateX(0);
  }

  #why-stay.why-visible .why-card-stagger {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--stagger-index, 0) * 0.14s + 0.15s);
  }
</style>
