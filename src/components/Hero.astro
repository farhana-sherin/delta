---
import { Image } from 'astro:assets';
import bgImage from '../assets/images/bg.webp';
import waveImage from '../assets/images/star-wave.webp';
---

<section class="relative h-screen min-h-[750px] w-full flex items-center overflow-hidden bg-[#16062b] selection:bg-[#D4A373]/30">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={bgImage} 
      alt="Hero Background" 
      class="w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Subtle gradient overlays for text readability & luxurious dark violet feel -->
    <div class="absolute inset-0 bg-[#210940]/40 mix-blend-overlay"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#120524]/90 via-[#120524]/50 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-[#0e031a]/95 to-transparent"></div>
  </div>

  <!-- Main Content Container -->
  <div class="relative z-10 w-full max-w-[1400px] mx-auto px-4 md:px-8 xl:px-10 ">
    
    <div class="max-w-3xl lg:max-w-5xl">
      <div class="inline-flex flex-col mb-3">
        <span class="text-[#D4A373] text-[10px] md:text-xs tracking-[0.3em] uppercase font-medium mb-3">
          WELCOME TO DELTA SUITES
        </span>
        <div class="relative w-full h-[1px] bg-[#D4A373]/50 flex items-center justify-center">
          <div class="absolute w-1.5 h-1.5 rotate-45 bg-[#D4A373]"></div>
        </div>
      </div>

      <!-- Main Heading -->
      <h1 class="text-5xl md:text-[64px] lg:text-[76px] font-serif text-white font-medium leading-[1.1] mb-8 drop-shadow-lg" style="font-family: 'Cormorant Garamond', serif;">
        A Relaxing Stay<br />
        <span class="text-white">in the </span>
        <span class="text-[#D4A373]">Heart of Beypore</span>
      </h1>
      


      <!-- Subheading -->
      <p class="text-base md:text-lg text-white/90 font-light mb-10 max-w-xl leading-relaxed tracking-wide drop-shadow-md">
        Discover comfort, leisure and warm Kerala hospitality at Delta Suites, Beypore.
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
        <a href="https://mobilebe.stayflexi.com/39879/?checkin=17-08-2026&num_nights=1&num_guests=2&source=google&hotel_id=39879" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-4 px-8 py-4 border border-[#D4A373] text-[#D4A373] uppercase tracking-[0.2em] text-[11px] font-semibold hover:bg-[#D4A373] hover:text-black transition-all duration-300 backdrop-blur-sm group rounded-full shadow-md">
          BOOK YOUR STAY
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transform group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/rooms" class="inline-flex items-center gap-4 px-8 py-4 border border-white/50 text-white uppercase tracking-[0.2em] text-[11px] font-semibold hover:bg-white hover:text-black transition-all duration-300 backdrop-blur-sm group rounded-full shadow-md">
          EXPLORE ROOMS
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transform group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- White Wave Cut for the bottom border transition -->
  <div class="absolute bottom-0 inset-x-0 z-10 pointer-events-none">
    <div class="relative w-full h-[60px] md:h-[120px]">
      <svg width="100%" height="100%" viewBox="0 0 1440 120" preserveAspectRatio="none" class="absolute bottom-0 w-full">
        <path d="M0,120 L0,40 Q720,160 1440,40 L1440,120 Z" fill="#fcf9f4" />
      </svg>
    </div>
  </div>

  <!-- Bottom Wave Shape & Star from provided Image -->
  <div class="absolute -bottom-40 md:-bottom-45 left-1/2 -translate-x-1/2 z-20 pointer-events-none w-[130vw] md:w-[110vw] min-w-[1440px] max-w-[1920px] flex justify-center drop-shadow-2xl">
    <Image 
      src={waveImage} 
      alt="Decorative Wave" 
      class="w-full h-auto object-contain object-bottom"
    />
  </div>
</section>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap');
</style>
